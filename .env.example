# ============================================================
# .env.example — Modèle de configuration des secrets et clés API
# ============================================================
#
# COMMENT UTILISER CE FICHIER :
# 1. Copie ce fichier en le renommant simplement ".env"
# 2. Remplace chaque valeur "ton-xxx-ici" par ta vraie clé
# 3. Ne commite JAMAIS le fichier ".env" (il est déjà dans .gitignore)
# 4. Pour partager la liste des clés nécessaires, partage ce .env.example
#
# RÈGLE D'OR : ce fichier (.env.example) ne contient JAMAIS de vraies clés.
# Il sert uniquement de modèle vide pour savoir quelles clés sont attendues.
# ============================================================


# -----------------------------
# IA et assistants
# -----------------------------
ANTHROPIC_API_KEY=ton-anthropic-api-key-ici
OPENAI_API_KEY=ton-openai-api-key-ici


# -----------------------------
# E-commerce — Shopify
# -----------------------------
SHOPIFY_STORE_URL=ton-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=ton-shopify-admin-token-ici
SHOPIFY_API_KEY=ton-shopify-api-key-ici
SHOPIFY_API_SECRET=ton-shopify-api-secret-ici


# -----------------------------
# Publicité — Meta (Facebook / Instagram Ads)
# -----------------------------
META_ACCESS_TOKEN=ton-meta-access-token-ici
META_AD_ACCOUNT_ID=act_xxxxxxxxxx
META_APP_ID=ton-meta-app-id-ici
META_APP_SECRET=ton-meta-app-secret-ici


# -----------------------------
# Google (Workspace, Analytics, Business, Ads)
# -----------------------------
GOOGLE_API_KEY=ton-google-api-key-ici
GOOGLE_CLIENT_ID=ton-google-client-id-ici
GOOGLE_CLIENT_SECRET=ton-google-client-secret-ici
GOOGLE_ANALYTICS_PROPERTY_ID=properties/xxxxxxxxx


# -----------------------------
# TikTok (For Business)
# -----------------------------
TIKTOK_ACCESS_TOKEN=ton-tiktok-access-token-ici
TIKTOK_APP_ID=ton-tiktok-app-id-ici
TIKTOK_APP_SECRET=ton-tiktok-app-secret-ici


# -----------------------------
# Communication — WhatsApp Business, Email
# -----------------------------
WHATSAPP_BUSINESS_TOKEN=ton-whatsapp-token-ici
WHATSAPP_PHONE_NUMBER_ID=ton-phone-number-id-ici

RESEND_API_KEY=ton-resend-api-key-ici
# ou alternative email
SENDGRID_API_KEY=ton-sendgrid-api-key-ici


# -----------------------------
# Outils annexes (ajouter selon besoin)
# -----------------------------
# NOTION_API_KEY=
# AIRTABLE_API_KEY=
# STRIPE_SECRET_KEY=
# ZAPIER_WEBHOOK_URL=
